{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "manifest.schema.json",
  "$ref": "#/definitions/sbo.webClient.uiApi.manifest",
  "title": "SAP Business One Web Client UI API Manifest Schema",
  "description": "A schema to define the manifest file for Web Client UI API.",
  "definitions": {
    "sbo.webClient.uiApi.manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "description": "The resource identifier for the JSON schema to be used. The value of this keyword MUST be a URI [RFC3986] (containing a scheme) and this URI MUST be normalized. The current schema MUST be valid against the meta-schema identified by this URI. If this URI identifies a retrievable resource, that resource SHOULD be of media type \"application/schema+json\".",
          "format": "uri",
          "type": "string"
        },
        "version": {
          "description": "Represents Application Descriptor format version. It is managed by schema owner",
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        },
        "name": {
          "type": "string",
          "description": "Represent the full qualified module name, concatenated by provider name, app name and module name, delimited by a dot."
        },
        "description": {
          "type": "string",
          "description": "Briefly describe your module from the functionality perspective."
        },
        "b1.bundles": {
          "type": "array",
          "description": "Define the UI bundles for the current module",
          "items": {
            "$ref": "#/definitions/B1Bundle"
          },
          "uniqueItems": true
        },
        "allowedServiceLayerAPIs": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\*$"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AllowedServiceLayerAPI"
              },
              "uniqueItems": true
            }
          ],
          "defaultSnippets": [
            {
              "label": "Allow all APIs (Default)",
              "body": "*"
            },
            {
              "label": "Allow no APIs",
              "body": []
            },
            {
              "label": "Allow some APIs (Sample)",
              "body": [
                {
                  "api": "BusinessPartners",
                  "authorization": "full",
                  "description": "full authorization on business partners"
                },
                {
                  "api": "Items",
                  "authorization": "readOnly",
                  "description": "readOnly authorization on items"
                },
                {
                  "api": "CompanyService_GetCompanyInfo",
                  "authorization": "full",
                  "description": "full authorization to get company info from company service"
                }
              ]
            }
          ],
          "description": "Define the allowed Service Layer APIs in a list. All APIs are allowed if specifying its value as \"*\". No API is allowed if this list is empty [].",
          "markdownDescription": "Define the allowed Service Layer APIs in a list. All APIs are allowed if specifying its value as `\"*\"`. No API is allowed if this list is empty `[]`.\nThe following example shows a typical usage to define an allowed list.\n```json\n\"allowedServiceLayerAPIs\": [\n    {\n      \"api\": \"BusinessPartners\",\n      \"authorization\": \"full\",\n      \"description\": \"full authorization on business partners\"\n    },\n    {\n      \"api\": \"CompanyService_GetCompanyInfo\",\n      \"authorization\": \"readOnly\",\n      \"description\": \"read-only authorization on company info from company service\"\n    }\n  ]\n```\n"
        },
        "allowedExternalURLs": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AllowedExternalURL"
              }
            },
            {
              "type": "string",
              "pattern": "^\\*$"
            }
          ],
          "defaultSnippets": [
            {
              "label": "Allow all URLs (Default)",
              "body": "*"
            },
            {
              "label": "Allow no URLs",
              "body": []
            },
            {
              "label": "Allow some URLs (Sample)",
              "body": [
                {
                  "endpoint": "https://services.odata.org",
                  "description": "public OData service"
                },
                {
                  "endpoint": "http://api.weatherapi.com",
                  "description": "free weather api"
                }
              ]
            }
          ],
          "markdownDescription": "Define the allowed external URLs in a list. All URLs are allowed to access if specifying its value as \"*\". No URL is allowed if this list is empty [].",
          "description": "Define the allowed external URLs in a list. All URLs are allowed to access if specifying its value as `\"*\"`. No URL is allowed if this list is empty `[]`.\nThe following example shows a typical usage to define an allowed list.\n```json\n\"allowedExternalURLs\": [\n    {\n      \"endpoint\": \"https://services.odata.org/V4/OData/OData.svc\",\n      \"description\": \"A public OData service in V4\"\n    },\n    {\n      \"endpoint\": \"http://api.weatherapi.com/v1\",\n      \"description\": \"A free weather api\"\n    }\n  ]\n```\n"
        },
        "mainBundle": {
          "type": "string",
          "description": "Specify the packaged JavaScript bundle file for production."
        }
      },
      "required": [
        "b1.bundles",
        "name",
        "allowedServiceLayerAPIs",
        "allowedExternalURLs"
      ],
      "title": "sbo.webClient.uiApi.manifest"
    },
    "AllowedExternalURL": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "qt-uri-protocols": [
            "http",
            "https"
          ],
          "qt-uri-extensions": [
            ".svc"
          ],
          "description": "A valid http/https URI scheme."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "endpoint"
      ],
      "title": "AllowedExternalURL"
    },
    "AllowedServiceLayerAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "string",
          "description": "Specify the exposed Service Layer entity or function/action, such as Orders, Items, BusinessPartners, CompanyService_GetCompanyInfo, etc."
        },
        "authorization": {
          "type": "string",
          "enum": [
            "full",
            "readOnly",
            "none"
          ],
          "default": "full",
          "markdownDescription": "Select a valid authorization value from this value list `[\"full\", \"readOnly\", \"none\"]`.",
          "description": "Select an authorization value from the valid value list [\"full\", \"readOnly\", \"none\"]."
        },
        "description": {
          "type": "string",
          "description": "Give a human-readable description for this API."
        }
      },
      "required": [
        "api"
      ],
      "title": "AllowedServiceLayerAPI"
    },
