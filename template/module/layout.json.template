{
	"controller": "<%= namespace %>.controller.<%= viewName %>",
	"overlay": {
		"before": [
			{
				"guid": "<%= Sample control's GUID %>",
				"items": [
					{
						"guid": "<%= New control's GUID %>",
						"ctrlType": "b1.sdk.Button",
						"text": "{@@i18n>buttonText}",
						"icon": "sap-icon://customize",
						"enabled": true,
						"visible": true,
						"buttonType": "Emphasized",
						"tooltip": "A button created by WebClient UI API",
						"press": {
							"procName": "onButtonClick"
						}
					}
				]
			}
		]
	}
}
